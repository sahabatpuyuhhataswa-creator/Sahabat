# GEMINI_API_KEY: Required for Gemini AI API calls (PuyuhAI Advisor & Audit).
# In AI Studio: Automatically injected.
# In Vercel: Set Key as GEMINI_API_KEY and Value as your Google AI Studio API key (without quotes, e.g. AIzaSy...).
# (Also accepts GOOGLE_API_KEY or VITE_GEMINI_API_KEY)
GEMINI_API_KEY="AIzaSy..."

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
